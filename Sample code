# -------------------------------
# Complete display_weather()
# -------------------------------
def display_weather(data):

    city_name = data["name"]
    country = data["sys"]["country"]

    temperature = kelvin_to_celsius(data["main"]["temp"])
    feels_like = kelvin_to_celsius(data["main"]["feels_like"])

    humidity = data["main"]["humidity"]
    pressure = data["main"]["pressure"]

    wind_speed = data["wind"]["speed"]

    weather = data["weather"][0]["description"].title()

    sunrise = unix_to_time(data["sys"]["sunrise"])
    sunset = unix_to_time(data["sys"]["sunset"])

    current_date = datetime.now().strftime("%d %B %Y")
    current_time = datetime.now().strftime("%I:%M %p")

    city_value.config(text=city_name)
    country_value.config(text=country)

    temp_value.config(text=f"{temperature} °C")
    feels_value.config(text=f"{feels_like} °C")

    humidity_value.config(text=f"{humidity}%")
    pressure_value.config(text=f"{pressure} hPa")

    wind_value.config(text=f"{wind_speed} m/s")

    weather_value.config(text=weather)

    sunrise_value.config(text=sunrise)
    sunset_value.config(text=sunset)

    date_value.config(
        text=f"{current_date}\n{current_time}"
    )


